{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(npm install *)",
      "Bash(npm run *)",
      "Bash(node *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git commit -m ' *)",
      "Bash(git push *)",
      "Bash(gh *)",
      "Bash(curl *)",
      "Bash(vercel *)",
      "Bash(npx vercel *)",
      "mcp__ide__getDiagnostics",
      "WebFetch(domain:github.com)",
      "WebSearch"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env*)"
    ]
  }
}
